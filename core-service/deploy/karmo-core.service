[Unit]
Description=KARMO Core Control and Approval Layer
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/karmo/core-service
ExecStart=/usr/bin/python3 -m core_service.runner
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
