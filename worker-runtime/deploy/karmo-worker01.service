[Unit]
Description=KARMO Remote Worker01 Polling Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=karmo
Group=karmo
WorkingDirectory=/opt/karmo/worker-runtime/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/karmo/worker-runtime/app
ExecStartPre=/usr/bin/python3 -m remote_worker_runtime --config /etc/karmo/worker01.json --check-config
ExecStart=/usr/bin/python3 -m remote_worker_runtime --config /etc/karmo/worker01.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
