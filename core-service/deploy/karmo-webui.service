[Unit]
Description=KARMO Web UI (tailnet HTTPS)
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/karmo/core-service
ExecStart=/usr/bin/python3 -m core_service webui tailscale-https
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# ask_claude/ask_gpt spawn their CLIs as this non-root account (see
# core_service/delegation_runner.py). It must exist and be logged in to
# both CLIs; /etc/karmo/core is 700 root, so it cannot read secrets.
Environment=KARMO_DELEGATE_CLI_USER=karmo-ask
NoNewPrivileges=true
PrivateTmp=true
# Sandbox (Fable review item 7, 2026-10-11): the whole filesystem is
# read-only to this service except the paths it really writes -- the
# Tailscale cert it renews, the upload library, and the karmo-ask home
# the Claude/GPT CLIs run in ("-" = skip if it doesn't exist yet).
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=-/etc/karmo/core/tailscale-tls -/var/lib/karmo/uploads -/var/lib/karmo-ask
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
