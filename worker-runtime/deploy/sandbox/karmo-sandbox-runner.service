[Unit]
Description=KARMO code sandbox runner (runs worker code_run jobs in no-network containers)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/karmo/worker-runtime/app/code_sandbox.py --serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/karmo/sandbox
UMask=0027

[Install]
WantedBy=multi-user.target
